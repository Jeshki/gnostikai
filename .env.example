# Public site URL for canonical tags, sitemap, and Open Graph
# NEXT_PUBLIC_SITE_URL=https://your-domain.tld

# Google Analytics 4 measurement ID (G-XXXXXXXX). City/country reports.
# Leave empty to skip GA and the cookie banner; Vercel Analytics still runs.
# NEXT_PUBLIC_GA_MEASUREMENT_ID=G-TWF1EM317K

# Search Console / webmaster verification tokens (HTML tag method)
# Google Search Console → Settings → Ownership verification → HTML tag
# NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
# Bing Webmaster Tools → HTML meta tag
# NEXT_PUBLIC_BING_SITE_VERIFICATION=
# Yandex Webmaster → meta tag
# NEXT_PUBLIC_YANDEX_VERIFICATION=

# DeepL API — https://www.deepl.com/your-account/keys
# Free keys end with :fx (500 000 characters / month).
# Never commit the real key. .env* is gitignored.
DEEPL_API_KEY=
# Optional: reuse a glossary after the first run
# DEEPL_GLOSSARY_ID=
